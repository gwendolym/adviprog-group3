// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int     @id @default(autoincrement())
  email         String  @unique
  name          String?
  roles         Roles[]
  passwordHash  String?
  emailVerified Boolean @default(false)
  holidayCountry String? @default("SE")

  teams         TeamMember[] // User can be associated with multiple TeamMember records.
  updatedMeetingDocuments MeetingDocument[]
  participants  Participant[]
  createdEvents Event[]
  oauthAccounts OAuthAccount[]
}

model OAuthAccount {
  provider  String
  subject   String
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, subject])
  @@index([userId])
}

enum Roles {
  MEMBER
  ADMIN
}

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[] // A team can be associated with multiple TeamMember records.
  events    Event[]
}

model TeamMember {
  teamId   String
  userId   Int
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Event {
  id           String        @id @default(cuid())
  name         String
  dates        DateTime[]
  startTime    String
  endTime      String
  timezone     String
  createdAt    DateTime      @default(now())
  meetUrl      String?
  creatorId    Int?
  creator      User?         @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  participants Participant[]
  meetingDocument MeetingDocument?
  teamId       String?
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  linkAccess   Boolean       @default(false)

  @@index([teamId])
}

model Participant {
  id           Int      @id @default(autoincrement())
  name         String
  availability String[]
  eventId      String
  userId       Int?
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, name])
}

model MeetingDocument {
  id          String   @id @default(cuid())
  eventId     String   @unique
  agenda      String   @default("")
  notes       String   @default("")
  updatedAt   DateTime @updatedAt
  updatedById Int?

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

